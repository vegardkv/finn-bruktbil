# Supabase Configuration
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# OpenAI API Configuration
# Required when parse_aux_data is enabled in download config
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Statens vegvesen (SVV) API Configuration
# Optional: used to look up vehicle import status by registration number
# Get your API key from: https://www.vegvesen.no/om-oss/apne-data/api/
SVV_API_KEY=your-api-key-here
